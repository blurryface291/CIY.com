rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['admin', 'masterAdmin'];
    }
    
    function isMasterAdmin() {
      return isAuthenticated() && getUserRole() == 'masterAdmin';
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isMasterAdmin()
      );
      allow delete: if isMasterAdmin();
    }
    
    // Content collections - read by all authenticated, write by admins
    match /announcements/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /study_materials/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /videos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /schedules/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /meetings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /magazines/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Payments - students read own, admins read/write all
    match /payments/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }
  }
}
